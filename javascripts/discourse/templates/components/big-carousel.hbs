{{#if shouldDisplay}}
  <div class="custom-big-carousel">
    <div class="custom-big-carousel-slides">
      {{#each bigStaticSlides as |bs|}}
        <a
          href={{bs.link}}
          class="custom-big-carousel-slide {{if
            (or bs.image_url bs.mobile_image_url)
            "has-image"
          }}"
          style={{html-safe (concat "background-color:" bs.slide_bg_color ";")}}
        >
          {{#if bs.image_url}}
            <img
              class="custom-big-carousel-image{{if
                bs.mobile_image_url
                " is-desktop"
              }}"
              src={{bs.image_url}}
              alt={{bs.headline}}
            />
          {{/if}}
          {{#if bs.mobile_image_url}}
            <img
              class="custom-big-carousel-image{{if bs.image_url " is-mobile"}}"
              src={{bs.mobile_image_url}}
              alt={{bs.headline}}
            />
          {{/if}}
          <div class="custom-big-carousel-content">
            <div class="custom-big-carousel-outer-wrap wrap">
              <div
                class="custom-big-carousel-inner-wrap"
                style={{html-safe (concat "background:" bs.text_bg)}}
              >
                <div class="custom-big-carousel-main-content">
                  <h2>
                    {{bs.headline}}
                  </h2>

                  <p>
                    {{bs.text}}
                  </p>

                  {{#if (and bs.button_text bs.link)}}
                    <a href={{bs.link}} class="btn btn-primary btn-text">
                      {{bs.button_text}}
                    </a>
                  {{/if}}
                </div>
              </div>
            </div>
          </div>
        </a>
      {{/each}}

      {{#each bigUserSlides as |bs|}}
        <a
          href="/u/{{bs.link}}"
          class="custom-big-carousel-slide user-slide {{if
            (or bs.image_url bs.mobile_image_url)
            "has-image"
          }}"
          style={{html-safe (concat "background-color:" bs.slide_bg_color ";")}}
        >
          {{#if bs.image_url}}
            <img
              class="custom-big-carousel-image{{if
                bs.mobile_image_url
                " is-desktop"
              }}"
              src={{bs.image_url}}
              alt={{bs.headline}}
            />
          {{/if}}
          {{#if bs.mobile_image_url}}
            <img
              class="custom-big-carousel-image{{if bs.image_url " is-mobile"}}"
              src={{bs.mobile_image_url}}
              alt={{bs.headline}}
            />
          {{/if}}
          <div class="custom-big-carousel-content">
            <div class="custom-big-carousel-outer-wrap wrap">
              <div class="custom-big-carousel-inner-wrap">
                <div class="custom-big-carousel-main-content">
                  <h4>
                    {{bs.headline}}
                  </h4>
                  <div style={{html-safe (concat "background:" bs.text_bg)}}>
                    <h3>
                      <span>
                        {{avatar bs.user_info.user imageSize="huge"}}
                        {{bs.user_info.user.username}}
                      </span>
                    </h3>
                  </div>

                  <p class="bs-main-text">
                    {{bs.text}}
                  </p>
                </div>

                {{#if bs.user_activity}}
                  <div class="bc-user-activity">
                    <h4>Recent Activity</h4>

                    {{#each bs.user_activity as |activity|}}
                      <div class="bc-user-post" data-topic-id="{{activity.topic_id}}">
                        <div class="bc-user-post-title">
                          {{activity.title}}
                        </div>
                        <p class="bc-user-post-excerpt">
                          {{html-safe activity.excerpt}}
                        </p>
                      </div>
                    {{/each}}
                  </div>
                {{/if}}
              </div>
            </div>
          </div>
        </a>
      {{/each}}
    </div>

    <div class="custom-big-carousel-controls">
      <div class="custom-big-carousel-prev">
        {{d-icon "chevron-left"}}
      </div>

      <div class="custom-big-carousel-nav">
        {{#each bigStaticSlides}}
          <div class="custom-big-carousel-nav-item"></div>
        {{/each}}

        {{#each bigUserSlides}}
          <div class="custom-big-carousel-nav-item"></div>
        {{/each}}
      </div>

      <div class="custom-big-carousel-next">
        {{d-icon "chevron-right"}}
      </div>
    </div>

    {{conditional-loading-spinner condition=isLoading}}
  </div>
{{/if}}